{
  "version": 2,
  "name": "edupilot-ai",
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/chat",
      "methods": ["POST"],
      "dest": "https://edupilot-ai-backend.onrender.com/chat"
    },
    {
      "src": "/chat",
      "methods": ["GET"],
      "dest": "frontend/chat.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://edupilot-ai-backend.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
