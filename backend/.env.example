# ==============================================================================
# EduPilot AI — Production Environment Variables Reference (Backend)
# Copy this file to backend/.env and replace placeholders with your secrets.
# ==============================================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

APP_URL=https://edupilot-ai.vercel.app
FRONTEND_URL=https://edupilot-ai.vercel.app
CORS_ORIGIN=https://edupilot-ai.vercel.app,*.vercel.app

OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=openrouter/free

DB_HOST=aws.connect.psdb.cloud
DB_PORT=3306
DB_USER=your_cloud_db_username
DB_PASSWORD=your_cloud_db_password
DB_NAME=edupilot_db
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
