# ==============================================================================
# EduPilot AI — Production Environment Variables Reference
# Copy this file to .env (or backend/.env) and replace placeholders with your secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Production App URL (Used in OpenRouter HTTP-Referer header & CORS)
APP_URL=https://edupilot-ai.vercel.app
FRONTEND_URL=https://edupilot-ai.vercel.app

# CORS Policy Origins (Comma-separated allowed origins or wildcard '*')
CORS_ORIGIN=https://edupilot-ai.vercel.app,*.vercel.app

# ------------------------------------------------------------------------------
# 2. OPENROUTER AI CONFIGURATION
# ------------------------------------------------------------------------------
# OpenRouter API Key (Required for AI chat capabilities)
# Obtain from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# AI Model Identifier (Default: openrouter/free or deepseek/deepseek-chat)
# Examples: openrouter/free, deepseek/deepseek-chat, google/gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# 3. CLOUD MYSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Database Hostname (PlanetScale, Aiven, Railway, Render, AWS RDS, etc.)
DB_HOST=aws.connect.psdb.cloud

# Database Port (Default MySQL port: 3306)
DB_PORT=3306

# Database User & Password
DB_USER=your_cloud_db_username
DB_PASSWORD=your_cloud_db_password

# Database Name
DB_NAME=edupilot_db

# Enable SSL for Cloud MySQL Connection (Required for PlanetScale, Aiven, etc.)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# 4. RATE LIMITING SECURITY
# ------------------------------------------------------------------------------
# Rate Limit Window in milliseconds (Default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP within rate limit window (Default: 100)
RATE_LIMIT_MAX=100
